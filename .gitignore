# Dependencies
node_modules/
bun.lockb

# Environment
.env
.env.local
.env.*.local
# Production credentials. Deliberately NOT covered by the `.env.*.local` rule
# above, so it has to be listed: this file holds live Mindbody OAuth secrets and
# must never reach a commit.
.env.production
# Development credentials. Holds a 1Password service account token, so it must never reach a commit.
.env.development

# Build output
dist/
build/
*.js
*.js.map
*.d.ts
*.d.ts.map

# Keep TypeScript source files
!src/**/*.ts

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Agent worktrees
# Claude Code and OpenCode worktrees are full copies of this repo, so anything
# that walks the tree finds every file twice or more: rg and fd both honour
# .gitignore, and bun test would run the whole suite once per worktree (which is
# why bunfig.toml scopes discovery to tests/). These dirs hold no tracked files.
.claude/worktrees/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
bun-error.log*

# Testing
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.cache/

# MCP specific
mcp-debug.log
