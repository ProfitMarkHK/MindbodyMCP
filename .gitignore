# Dependencies
node_modules/
bun.lockb

# Environment
.env
.env.local
.env.*.local
# Environment files. Policy: an env file may hold op:// references, never a
# credential value (AGENTS.md, Environment Variables). They stay ignored anyway,
# in case one ever holds a value by mistake.
#
# Live Mindbody OAuth credentials, if any ever land here. Deliberately NOT
# covered by the `.env.*.local` rule above, so it has to be listed: this file
# must never reach a commit.
.env.production
# May hold a 1Password service account token, so it must never reach a commit.
.env.development
# 1Password *references* only (op:// pointers, no secret values). Still local:
# the vault layout is not committed. Resolved by `op run --env-file .env.op-refs`.
# The glob covers the .prod variant used by scripts/mcp-sidecar.*.
.env.op-refs*

# Build output
dist/
build/
*.js
*.js.map
*.d.ts
*.d.ts.map

# Keep TypeScript source files
!src/**/*.ts

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Agent worktrees
# Claude Code and OpenCode worktrees are full copies of this repo, so anything
# that walks the tree finds every file twice or more: rg and fd both honour
# .gitignore, and bun test would run the whole suite once per worktree (which is
# why bunfig.toml scopes discovery to tests/). These dirs hold no tracked files.
.claude/worktrees/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
bun-error.log*

# Testing
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.cache/

# MCP specific
mcp-debug.log
