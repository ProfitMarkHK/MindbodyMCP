# Mindbody MCP — environment template
#
# Copy to `.env` (gitignored) for local overrides. This file is tracked, so it
# must never hold a value that is not already public.

# ── Credentials do not live in any env file ────────────────────────────────
# The four MINDBODY_* credentials are resolved from 1Password at launch. Prefer
# the launchers, which read an `op://` reference file and keep the 1Password
# service account token in the OS credential store (docs/SECRETS.md):
#
#   bun run launch:sandbox   # ~/.config/mindbody/sandbox.env; site pinned to -99
#   bun run launch:prod      # ~/.config/mindbody/prod.env
#
# A plain `op run --env-file <refs file> -- bun run src/index.ts` also works.
# 1Password Environments (`op run --environment=<id>`) are not an option for
# automation: a service account cannot perform Environment operations.
#
# A `.env` may hold `op://` references, but only in front of
# `op run --env-file`. bunfig.toml sets `dotenv = true`, so Bun loads `.env`
# verbatim: `MINDBODY_API_KEY=op://…` would reach the server as that literal
# string and the first API call would fail with an auth error.
#
# The names the server reads, for reference. Names only, never values here:
#
#   MINDBODY_API_KEY=op://<vault>/<item>/<api-key-field>
#   MINDBODY_SITE_ID=op://<vault>/<item>/<site-id-field>
#   MINDBODY_SOURCE_NAME=op://<vault>/<item>/<source-name-field>
#   MINDBODY_SOURCE_PASSWORD=op://<vault>/<item>/<source-password-field>

# ── Site target (non-secret) ───────────────────────────────────────────────
# -99 is the Mindbody sandbox, and this repository's local configuration is
# sandbox-only. `launch:sandbox` pins the site in code and omits this variable;
# production references belong in ~/.config/mindbody/prod.env (start from
# config/op-refs/prod.env.example) or your shell, never in this file.
MINDBODY_SITE_ID=-99
MINDBODY_API_URL=https://api.mindbodyonline.com/public/v6

# ── Live E2E tier ──────────────────────────────────────────────────────────
# tests/live/ reads a separate MINDBODY_TEST_* namespace and takes nothing from
# this file. Supply it through a references file and the wrapper:
#   op run --env-file <refs file> -- scripts/live-e2e.sh
# or let scripts/live-e2e.sh prompt for what is missing. Names only, never a
# value; see tests/live/README.md.
# MINDBODY_TEST_API_KEY=
# MINDBODY_TEST_SOURCE_NAME=
# MINDBODY_TEST_SOURCE_PASSWORD=
# MINDBODY_TEST_SITE_ID=
# MINDBODY_TEST_API_URL=

# ── Optional configuration (non-secret) ────────────────────────────────────
# IANA site timezone (e.g. America/Los_Angeles). Fallback only: used when GET /site/sites is reachable but has no usable TimeZone. Leave blank normally: if it disagrees with the site record, cancel tools refuse to write, and it is never used when the site lookup fails (e.g. a multi-site key with no MINDBODY_SITE_ID).
MINDBODY_SITE_TIMEZONE=
# Site late-cancel window in hours (the Mindbody API does not expose it). Set to 24: lateCancel is honoured only for sessions starting within a day. Unset or invalid: lateCancel requests are refused.
MINDBODY_LATE_CANCEL_WINDOW_HOURS=24
# Optional per-service late-cancel windows, JSON, checked in order before the default; first match wins. Each rule: {serviceId?, programId?, sessionTypeId?, hours}. serviceId is the pricing option (Visit.ProductId). Malformed rules refuse every lateCancel.
# MINDBODY_LATE_CANCEL_WINDOW_RULES=[{"serviceId":10,"hours":2},{"programId":3,"hours":24}]
CACHE_TTL_MINUTES=5
RATE_LIMIT_BUFFER=100

# MCP Server Configuration (optional)
MCP_SERVER_NAME=mindbody-mcp
MCP_SERVER_VERSION=2.0.0

# Transport Configuration (STDIO, SSE or HTTP)
MCP_TRANSPORT=stdio  # Options: stdio (default), sse or http
MCP_PORT=3000        # Port for the SSE server (default: 3000)
MCP_HOST=0.0.0.0     # Host for the SSE server (default: 0.0.0.0)

# Inbound client auth (SSE only). REQUIRED when MCP_HOST is not loopback
# (127.0.0.1, ::1, localhost): the server refuses to start without it. Every
# request except GET /health and OPTIONS must send
# "Authorization: Bearer <MCP_AUTH_TOKEN>". Generate one with:
#   openssl rand -hex 32
# On loopback it may be left empty for local development (one warning is printed).
MCP_AUTH_TOKEN=

# SSE-specific Configuration (optional)
MCP_CORS_ORIGIN=*    # Access-Control-Allow-Origin for SSE: one origin or * (no list; no credentials mode)
MCP_SSL_CERT=        # Path to SSL certificate file (for HTTPS)
MCP_SSL_KEY=         # Path to SSL private key file (for HTTPS)

# DNS rebinding protection (SSE and HTTP). ON by default.
# The server binds 0.0.0.0 by default, so browsers on other machines can reach
# /sse or /mcp. Protection validates the Host header (and Origin, if configured).
# When MCP_ALLOWED_HOSTS is unset it defaults to loopback only
# (localhost, 127.0.0.1, [::1]) plus the active port, so local dev needs no
# config. Set MCP_ALLOWED_HOSTS to your public hostname if remote clients connect.
MCP_ALLOWED_HOSTS=   # Comma-separated Host header values, e.g. mcp.example.com
MCP_ALLOWED_ORIGINS= # Comma-separated Origin header values; skipped if unset
MCP_DNS_REBINDING_PROTECTION=  # Set to false to disable protection (opt-out)

# Streamable HTTP transport (--transport http) for hosted use, e.g. Railway.
# Every client acts as the studio's one Mindbody login, so the server refuses to
# start without auth: set both CF_ACCESS_TEAM_DOMAIN and CF_ACCESS_AUD, or
# neither (which is an error unless MCP_ALLOW_UNAUTHENTICATED=true).
# Cloudflare Access does the Google Workspace sign-in and the MCP OAuth flow;
# this server only verifies the forwarded Cf-Access-Jwt-Assertion JWT.
CF_ACCESS_TEAM_DOMAIN=  # <team>.cloudflareaccess.com
CF_ACCESS_AUD=          # Access application's AUD tag
# Serves unauthenticated, but only when bound to a loopback host. Local use only.
MCP_ALLOW_UNAUTHENTICATED=false
# PORT is read when MCP_PORT is unset for the http transport (Railway sets it).
PORT=
