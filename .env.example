# Mindbody API Credentials
#
# The repo-local .env is sandbox-only. Do not keep naked MINDBODY_* values in
# this repository. Keep production credentials in .env.production, and keep the
# sandbox values in the MINDBODY_TEST_* namespace here.
#
# The agent or local wrapper must map TEST_* into the names the Mindbody API
# expects at runtime before any network call.
MINDBODY_TEST_API_KEY=your_api_key_here
MINDBODY_TEST_SITE_ID=-99
MINDBODY_TEST_SOURCE_NAME=your_source_name
MINDBODY_TEST_SOURCE_PASSWORD=your_source_password
MINDBODY_TEST_API_URL=https://api.mindbodyonline.com/public/v6

# ── Live E2E tier credentials — DELIBERATELY SEPARATE NAMESPACE ────────────
#
# Leave the values below commented out unless you are intentionally running the
# opt-in live tier. This tier is separate from the repo-local sandbox config and
# is designed to be entered from a terminal, not from this file.
#
# Sandbox API key, from the Mindbody developer portal. Required to run the tier.
# MINDBODY_TEST_API_KEY=
# Sandbox Source name — the user-token identity (POST /usertoken/issue). Required.
# MINDBODY_TEST_SOURCE_NAME=
# Sandbox Source password. Required.
# MINDBODY_TEST_SOURCE_PASSWORD=
# SiteId to test against. Optional, defaults to -99 (the sandbox). Any other
# value makes the tier REFUSE to run, because it writes records.
# MINDBODY_TEST_SITE_ID=
# Sandbox API base URL. Optional, defaults to the public v6 endpoint.
# MINDBODY_TEST_API_URL=
# Set to 1 to skip the live tier entirely, whatever else is configured.
# SKIP_LIVE_E2E=

# Optional Configuration
# IANA site timezone (e.g. America/Los_Angeles). Fallback only: used when GET /site/sites is reachable but has no usable TimeZone. Leave blank normally: if it disagrees with the site record, cancel tools refuse to write, and it is never used when the site lookup fails (e.g. a multi-site key with no MINDBODY_SITE_ID).
MINDBODY_SITE_TIMEZONE=
# Site late-cancel window in hours (the Mindbody API does not expose it). Unset: lateCancel requests are refused. Set: honoured only for sessions starting within this many hours.
MINDBODY_LATE_CANCEL_WINDOW_HOURS=
CACHE_TTL_MINUTES=5
RATE_LIMIT_BUFFER=100

# MCP Server Configuration (optional)
MCP_SERVER_NAME=mindbody-mcp
MCP_SERVER_VERSION=2.0.0

# Transport Configuration (STDIO or SSE)
MCP_TRANSPORT=stdio  # Options: stdio (default) or sse
MCP_PORT=3000        # Port for SSE server (default: 3000)
MCP_HOST=0.0.0.0     # Host for SSE server (default: 0.0.0.0)

# SSE-specific Configuration (optional)
MCP_CORS_ORIGIN=*    # CORS origin for SSE (use specific domain in production)
MCP_SSL_CERT=        # Path to SSL certificate file (for HTTPS)
MCP_SSL_KEY=         # Path to SSL private key file (for HTTPS)

# DNS rebinding protection (SSE only). ON by default.
# The server binds 0.0.0.0 by default, so browsers on other machines can reach
# /sse. Protection validates the Host header (and Origin, if configured).
# When MCP_ALLOWED_HOSTS is unset it defaults to loopback only
# (localhost, 127.0.0.1, [::1]) plus the active port, so local dev needs no
# config. Set MCP_ALLOWED_HOSTS to your public hostname if remote clients connect.
MCP_ALLOWED_HOSTS=   # Comma-separated Host header values, e.g. mcp.example.com
MCP_ALLOWED_ORIGINS= # Comma-separated Origin header values; skipped if unset
MCP_DNS_REBINDING_PROTECTION=  # Set to false to disable protection (opt-out)
