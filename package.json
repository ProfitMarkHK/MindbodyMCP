{
  "name": "@profitmarkhk/mindbody-mcp",
  "version": "2.0.2",
  "description": "Comprehensive MCP server for Mindbody API - Complete yoga studio management via AI assistants",
  "keywords": [
    "mcp",
    "mindbody",
    "api",
    "fitness",
    "wellness",
    "yoga",
    "pilates",
    "studio-management",
    "model-context-protocol",
    "claude",
    "ai-assistant"
  ],
  "author": "ProfitMarkHK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProfitMarkHK/MindbodyMCP.git"
  },
  "bugs": {
    "url": "https://github.com/ProfitMarkHK/MindbodyMCP/issues"
  },
  "homepage": "https://github.com/ProfitMarkHK/MindbodyMCP#readme",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mindbody-mcp": "src/index.ts"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE",
    "CLAUDE.md",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "op run -- bun run src/index.ts",
    "dev:sse": "op run -- bun run src/index.ts --transport sse",
    "dev:http": "op run -- bun run src/index.ts --transport http",
    "dev:sandbox": "op run -- bun run scripts/dev-sandbox.ts",
    "dev:sandbox:sse": "op run -- bun run scripts/dev-sandbox.ts --transport sse",
    "start": "op run -- bun run src/index.ts",
    "start:sse": "op run -- bun run src/index.ts --transport sse --port 3000",
    "start:http": "op run -- bun run src/index.ts --transport http --port 3000",
    "start:prod": "MCP_TRANSPORT=sse MCP_PORT=3000 op run -- bun run src/index.ts",
    "build": "tsc && chmod +x dist/index.js",
    "test": "bun test",
    "check": "bun scripts/check.ts",
    "test:tool": "bun run tests/test-tool.ts",
    "test:sse": "bun run tests/test-sse-client.ts",
    "benchmark": "bun run tests/benchmark.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --strict",
    "node:build": "tsc",
    "node:start": "op run -- node dist/index.js",
    "node:start:sse": "op run -- node dist/index.js --transport sse",
    "node:start:http": "op run -- node dist/index.js --transport http",
    "node:dev": "op run -- tsx src/index.ts",
    "node:dev:sse": "op run -- tsx src/index.ts --transport sse",
    "node:dev:http": "op run -- tsx src/index.ts --transport http",
    "prepublishOnly": "npm run build",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "spec:update": "bun run scripts/update-spec.ts",
    "spec:coverage": "bun run scripts/spec-coverage.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.21.1",
    "dotenv": "^18.0.10",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.1.6",
    "@types/node": "^26.6.6",
    "rimraf": "^6.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
