# Non-secret 1Password pointers for the SANDBOX MCP launcher.
# Copy to ~/.config/mindbody/sandbox.env and replace <vault> and <sandbox-item>
# with your sandbox 1Password vault and item. Never put values here.
# The sandbox site is pinned to -99 by scripts/dev-sandbox.ts, so no
# MINDBODY_SITE_ID pointer is needed here.
# The SAT itself is stored in the OS credential store (see docs/SECRETS.md).
MINDBODY_API_KEY=op://<vault>/<sandbox-item>/API_KEY
MINDBODY_SOURCE_NAME=op://<vault>/<sandbox-item>/SOURCE_NAME
MINDBODY_SOURCE_PASSWORD=op://<vault>/<sandbox-item>/SOURCE_PASSWORD
