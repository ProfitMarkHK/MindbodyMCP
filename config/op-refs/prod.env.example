# Non-secret 1Password pointers for the PROD MCP launcher.
# Copy to ~/.config/mindbody/prod.env and replace <prod-item-name> with the
# 1Password item that holds the live Mindbody credentials. Never put values here.
# The SAT itself is stored in the OS credential store (see docs/SECRETS.md).
MINDBODY_API_KEY=op://<vault>/<prod-item-name>/API_KEY
MINDBODY_SITE_ID=op://<vault>/<prod-item-name>/SITE_ID
MINDBODY_SOURCE_NAME=op://<vault>/<prod-item-name>/SOURCE_NAME
MINDBODY_SOURCE_PASSWORD=op://<vault>/<prod-item-name>/SOURCE_PASSWORD
